{
  "name": "ship-anything",
  "version": "0.1.0",
  "description": "Install SHIP ANYTHING agents, skills and workflows into any project for Claude Code, Codex, OpenCode, Cursor, Gemini CLI or any Agent Skills-compatible agent.",
  "license": "MIT",
  "author": "SHIP ANYTHING contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/offlineAu/ship-anything.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/offlineAu/ship-anything#readme",
  "bugs": {
    "url": "https://github.com/offlineAu/ship-anything/issues"
  },
  "type": "module",
  "bin": {
    "ship-anything": "bin/ship-anything.js"
  },
  "files": [
    "bin",
    "src",
    "content",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "bundle-content": "node scripts/bundle-content.mjs",
    "prepack": "node scripts/bundle-content.mjs",
    "postpack": "node -e \"require('fs').rmSync('content',{recursive:true,force:true})\""
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "opencode",
    "cursor",
    "gemini-cli",
    "ai-agents",
    "orchestration"
  ],
  "dependencies": {
    "yaml": "2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
